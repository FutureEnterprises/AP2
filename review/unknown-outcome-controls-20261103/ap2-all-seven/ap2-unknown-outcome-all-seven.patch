+def test_signed_checkout_reissue_is_a_distinct_hash_identity(rig):
+    first_checkout = rig.checkout('same-business-checkout')
+    # ES256 re-signing the identical validated checkout payload produces a
+    # different JWT signature. Both are legitimate merchant-signed bytes.
+    second_checkout = rig.checkout('same-business-checkout')
+    merchant_public = JWK.from_json(rig.merchant.export_public())
+    payload1 = rig.api.verify_jwt(first_checkout, merchant_public)
+    payload2 = rig.api.verify_jwt(second_checkout, merchant_public)
+    assert payload1 == payload2
+    assert first_checkout != second_checkout
+    first, _ = rig.issue(first_checkout, 'reissue-first')
+    rig.lose_delivery = True
+    with pytest.raises(ConnectionError):
+        rig.call(first, first_checkout, 'reissue-first-unknown')
+    second, _ = rig.issue(second_checkout, 'reissue-second')
+    rig.lose_delivery = False
+    result = rig.call(second, second_checkout, 'reissued-same-business-object')
+    rig.assert_boundary('reissued-same-business-object', True)
+    assert result['status'] == 'success' and len(rig.receipts) == 2
+    assert len(rows(rig.transactions)) == 2
+    rig.save(
+        'signed-checkout-reissue',
+        checkout_payloads_exactly_equal=True,
+        business_checkout_id=payload1['id'],
+        first_transaction_id=rig.api.compute_sha256_b64url(first_checkout),
+        second_transaction_id=rig.api.compute_sha256_b64url(second_checkout),
+        result=result['status'],
+        real_receipt_count=2,
+        interpretation='distinct AP2 hash-defined transaction identities; not a same-hash bypass',
+    )
+
