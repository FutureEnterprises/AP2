+def test_eight_distinct_valid_authorizations_race_one_checkout(rig):
+    checkout = rig.checkout()
+    issued = [rig.issue(checkout, 'race-' + str(i)) for i in range(8)]
+    assert len({token for token, _ in issued}) == 8
+    assert len({reference for _, reference in issued}) == 8
+    barrier = threading.Barrier(8)
+
+    def invoke(pair):
+        i, (token, _) = pair
+        barrier.wait()
+        return rig.call(token, checkout, 'race-' + str(i))
+
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        results = list(pool.map(invoke, enumerate(issued)))
+    assert sum(r.get('status') == 'success' for r in results) == 1
+    assert sum(r.get('error') == 'mandate_already_used' for r in results) == 7
+    assert len(rig.receipts) == 1 and len(rows(rig.transactions)) == 1
+    for i, result in enumerate(results):
+        rig.assert_boundary('race-' + str(i), result.get('status') == 'success')
+    rig.save(
+        'eight-fresh-authorizations',
+        results=results,
+        real_receipt_count=1,
+        verified_boundary_calls=8,
+    )
+
