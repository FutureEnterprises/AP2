+def test_fresh_valid_authorization_after_unknown_same_checkout(rig):
+    checkout = rig.checkout()
+    first, reference1 = rig.issue(checkout, 'first')
+    rig.lose_delivery = True
+    with pytest.raises(ConnectionError, match='outcome unknown'):
+        rig.call(first, checkout, 'first-unknown')
+    rig.assert_boundary('first-unknown', True)
+    assert len(rig.receipts) == 1
+    before = rows(rig.transactions)
+    second, reference2 = rig.issue(checkout, 'fresh-authorization')
+    assert first != second and reference1 != reference2
+    replay = rig.call(second, checkout, 'fresh-same-checkout')
+    assert replay['error'] == 'mandate_already_used'
+    rig.assert_boundary('fresh-same-checkout', False)
+    assert len(rig.receipts) == 1 and rows(rig.transactions) == before
+
+    rig.lose_delivery = False
+    new_checkout = rig.checkout('business-checkout-2')
+    fresh, _ = rig.issue(new_checkout, 'new-checkout')
+    positive = rig.call(fresh, new_checkout, 'new-checkout')
+    rig.assert_boundary('new-checkout', True)
+    assert positive['status'] == 'success' and len(rig.receipts) == 2
+    assert len(rows(rig.transactions)) == 2
+    rig.save(
+        'unknown-same-checkout',
+        first_outcome='unknown to caller after signed receipt',
+        fresh_authorization_result='cryptographically valid; issuer minted distinct token',
+        replay=replay,
+        receipt_count_after_replay=1,
+        new_checkout_status=positive['status'],
+        final_receipt_count=2,
+        first_reference=reference1,
+        second_reference=reference2,
+    )
+
