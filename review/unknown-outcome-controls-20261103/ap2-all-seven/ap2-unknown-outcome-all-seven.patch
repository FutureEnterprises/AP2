+def test_processor_restart_retains_unknown_checkout_marker(rig):
+    checkout = rig.checkout()
+    first, _ = rig.issue(checkout, 'restart-first')
+    rig.lose_delivery = True
+    with pytest.raises(ConnectionError):
+        rig.call(first, checkout, 'restart-first-unknown')
+    second, _ = rig.issue(checkout, 'restart-fresh')
+    request = rig.directory / 'restart-request.json'
+    request.write_text(
+        json.dumps(
+            {
+                'directory': str(rig.directory),
+                'token': second,
+                'checkout_hash': rig.api.compute_sha256_b64url(checkout),
+                'open_hash': rig.open_hash,
+            }
+        )
+    )
+    completed = subprocess.run(
+        [
+            sys.executable,
+            '-B',
+            str(Path(__file__).resolve()),
+            '--restart-worker',
+            str(request),
+        ],
+        text=True,
+        capture_output=True,
+        check=False,
+        timeout=30,
+    )
+    assert completed.returncode == 0, completed.stderr
+    evidence = json.loads(completed.stdout)
+    assert evidence['result']['error'] == 'mandate_already_used'
+    assert evidence['receipt_count'] == 0
+    assert evidence['verification_passes'] == 1
+    assert evidence['constraint_passes'] == 1
+    assert evidence['reservation_attempts'] == [False]
+    assert len(rig.receipts) == 1 and len(rows(rig.transactions)) == 1
+    rig.save(
+        'processor-restart',
+        child=evidence,
+        original_receipt_count=1,
+        subprocess_returncode=completed.returncode,
+    )
+
+
+def restart_worker(request):
+    directory = Path(request['directory'])
+    os.environ['LOGS_DIR'] = str(directory / 'restart-logs')
+    os.environ['TEMP_DB_DIR'] = str(directory / 'restart-unused-default-state')
+    original_connect = socket.socket.connect
+    socket.socket.connect = lambda sock, address: offline_connect(
+        original_connect, sock, address
+    )
+    api = load_api()
+    api.mandate_module.LOG_FILE_PATH = str(directory / 'restart-mandates.jsonl')
+    # A new interpreter imports the real processor and reopens the exact
+    # persisted SQLite database; it does not receive the old in-memory rig.
+    evidence = {
+        'receipt_count': 0,
+        'verification_passes': 0,
+        'constraint_passes': 0,
+        'reservation_attempts': [],
+    }
+    api.mpp._TOKEN_STORE_PATH = directory / 'tokens.json'
+    api.mpp._CONSUMED_TRANSACTIONS_PATH = directory / 'transactions.sqlite3'
+    api.mpp.AGENT_PROVIDER_PUB_PATH = directory / 'authority.pub'
+    original_verify = api.MandateClient.verify
+    original_constraints = api.PaymentMandateChain.verify
+    original_reserve = api.mpp.reserve_once
+    original_receipt = api.ReceiptClient.create_payment_receipt
+
+    def verify(client, *args, **kwargs):
+        result = original_verify(client, *args, **kwargs)
+        evidence['verification_passes'] += 1
+        return result
+
+    def constraints(chain, *args, **kwargs):
+        result = original_constraints(chain, *args, **kwargs)
+        if not result:
+            evidence['constraint_passes'] += 1
+        return result
+
+    def reserve(*args, **kwargs):
+        result = original_reserve(*args, **kwargs)
+        evidence['reservation_attempts'].append(result)
+        return result
+
+    def receipt(client, *args, **kwargs):
+        evidence['receipt_count'] += 1
+        return original_receipt(client, *args, **kwargs)
+
+    async def forbidden_delivery(_receipt):
+        raise AssertionError('replay must not reach receipt delivery')
+
+    api.MandateClient.verify = verify
+    api.PaymentMandateChain.verify = constraints
+    api.mpp.reserve_once = reserve
+    api.ReceiptClient.create_payment_receipt = receipt
+    api.mpp._send_payment_receipt_to_credentials_provider = forbidden_delivery
+    evidence['result'] = asyncio.run(
+        api.mpp.initiate_payment(
+            request['token'], request['checkout_hash'], request['open_hash']
+        )
+    )
+    print(json.dumps(evidence))
+
+
+if __name__ == '__main__' and sys.argv[1:2] == ['--restart-worker']:
+    restart_worker(json.loads(Path(sys.argv[2]).read_text()))
