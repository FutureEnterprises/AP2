+@pytest.mark.parametrize('failure', ['corrupt', 'directory', 'busy'])
+def test_actual_processor_fails_closed_when_replay_state_unavailable(
+    rig, failure
+):
+    checkout = rig.checkout()
+    token, _ = rig.issue(checkout, failure)
+    lock = None
+    if failure == 'corrupt':
+        rig.transactions.write_bytes(b'not a SQLite database')
+    elif failure == 'directory':
+        rig.transactions.mkdir()
+    else:
+        assert rig.api.mpp.reserve_once(
+            rig.transactions, 'unrelated-existing-key'
+        )
+        lock = sqlite3.connect(rig.transactions, isolation_level=None)
+        lock.execute('BEGIN IMMEDIATE')
+    try:
+        result = rig.call(token, checkout, 'state-' + failure)
+    finally:
+        if lock:
+            lock.rollback()
+            lock.close()
+    assert result['error'] == 'replay_state_unavailable'
+    assert len(rig.receipts) == 0
+    trace = [e for e in rig.trace if e['attempt'] == 'state-' + failure]
+    assert trace[-1]['event'] == 'processor_reservation'
+    assert trace[-1]['exception'] == 'ReservationStoreError'
+    assert trace[-2]['violations'] == []
+    rig.save('state-' + failure, result=result, real_receipt_count=0)
+
